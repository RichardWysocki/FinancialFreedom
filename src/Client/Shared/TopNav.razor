@implements IDisposable
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationStateProvider

<header class="amazon-header">
    <div class="amazon-inner container-fluid">
        <a class="amazon-brand text-decoration-none" href="">FinancialFreedom</a>

        <button type="button" class="amazon-menu-toggle d-md-none" @onclick="ToggleMenu" aria-expanded="@(!_menuCollapsed)" aria-controls="amazon-top-nav">
            Menu
        </button>

        <div id="amazon-top-nav" class="amazon-nav-wrap @NavWrapClass">
            <nav class="amazon-nav-links" @onclick="OnNavWrapClick">
                <NavLink class="amazon-nav-link" href="" Match="NavLinkMatch.All">Home</NavLink>
                <NavLink class="amazon-nav-link" href="counter">Counter</NavLink>
                <NavLink class="amazon-nav-link" href="fetchdata">Fetch data</NavLink>
                <NavLink class="amazon-nav-link" href="wellness">Wellness</NavLink>
                <NavLink class="amazon-nav-link" href="future-salary">Future salary</NavLink>
                <AuthorizeView>
                    <Authorized>
                        <NavLink class="amazon-nav-link" href="page-visit-log">Page visits</NavLink>
                    </Authorized>
                </AuthorizeView>
            </nav>
            <div class="amazon-account">
                <UserAccountStrip />
            </div>
        </div>
    </div>
</header>

@code {
    private bool _menuCollapsed = true;

    private string NavWrapClass => _menuCollapsed ? "amazon-nav-collapsed" : "";

    protected override void OnInitialized()
    {
        AuthenticationStateProvider.AuthenticationStateChanged += OnAuthChanged;
    }

    private void OnAuthChanged(Task<AuthenticationState> authStateTask)
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private void ToggleMenu() => _menuCollapsed = !_menuCollapsed;

    private void OnNavWrapClick()
    {
        if (_menuCollapsed)
            return;
        _menuCollapsed = true;
    }

    public void Dispose()
    {
        AuthenticationStateProvider.AuthenticationStateChanged -= OnAuthChanged;
    }
}
