<div class="amazon-account-inner">
    <AuthorizeView>
        <Authorized>
            @if (_profile is null && _loadError is null)
            {
                <span class="amazon-account-muted">Loading account…</span>
            }
            else if (_loadError is not null)
            {
                <span class="amazon-account-muted">@_loadError</span>
            }
            else if (_profile is not null)
            {
                <div class="amazon-account-text">
                    <span class="amazon-hello">Hello, <strong>@DisplayName</strong></span>
                    <span class="amazon-last-login">Last sign-in: @FormatLastLogin(_profile.LastLoginAt)</span>
                </div>
                <NavLink class="amazon-nav-link amazon-signout" href="logout">Sign out</NavLink>
            }
        </Authorized>
        <NotAuthorized>
            <NavLink class="amazon-nav-link" href="login">Sign in</NavLink>
            <NavLink class="amazon-nav-link" href="register">Register</NavLink>
        </NotAuthorized>
    </AuthorizeView>
</div>
