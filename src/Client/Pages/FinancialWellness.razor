@page "/wellness"

<PageTitle>Financial wellness links</PageTitle>

<div class="wellness-page">
    <header class="wellness-header mb-4">
        <h1>Financial wellness hub</h1>
        <p class="text-muted mb-0">
            Curated calculators and references in one place. Use the index to jump to a section; each link opens in a new tab.
        </p>
    </header>

    <div class="wellness-layout">
        <aside class="wellness-toc card shadow-sm">
            <div class="card-header">Jump to section</div>
            <div class="list-group list-group-flush">
                @for (var i = 0; i < _sections.Length; i++)
                {
                    var s = _sections[i];
                    var id = SectionId(i);
                    <a class="list-group-item list-group-item-action" href="@($"#{id}")">@s.Title</a>
                }
            </div>
        </aside>

        <div class="wellness-main">
            @for (var i = 0; i < _sections.Length; i++)
            {
                var sec = _sections[i];
                var id = SectionId(i);
                <section class="card mb-3 shadow-sm" id="@id">
                    <div class="card-header fw-semibold">@sec.Title</div>
                    <ul class="list-group list-group-flush">
                        @foreach (var link in sec.Links)
                        {
                            <li class="list-group-item">
                                <a href="@link.Url" target="_blank" rel="noopener noreferrer" class="fw-medium">@link.Label</a>
                                @if (!string.IsNullOrEmpty(link.Hint))
                                {
                                    <div class="small text-muted mt-1">@link.Hint</div>
                                }
                            </li>
                        }
                    </ul>
                </section>
            }
        </div>
    </div>
</div>

