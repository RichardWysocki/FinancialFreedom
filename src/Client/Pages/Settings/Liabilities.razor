@page "/settings/liabilities"

<PageTitle>Liabilities</PageTitle>
<MudText Typo="Typo.h5" Class="mb-3">Liabilities</MudText>

<MudButton Class="mb-3" Variant="Variant.Filled" Color="MudBlazor.Color.Warning" OnClick="@(() => Open(null))">Add</MudButton>

<MudTable Items="_rows" Dense="true" Hover="true" Striped="true">
    <HeaderContent>
        <MudTh>Name</MudTh>
        <MudTh>Type</MudTh>
        <MudTh style="text-align:right">Balance</MudTh>
        <MudTh></MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd>@context.Name</MudTd>
        <MudTd>@context.LiabilityType</MudTd>
        <MudTd style="text-align:right">@context.CurrentBalance.ToString("C")</MudTd>
        <MudTd>
            <MudIconButton Icon="@Icons.Material.Filled.Edit" OnClick="@(() => Open(context))" />
            <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="MudBlazor.Color.Error" OnClick="@(() => Delete(context.Id))" />
        </MudTd>
    </RowTemplate>
</MudTable>

<MudDialog @bind-Visible="_dialog">
    <TitleContent><MudText Typo="Typo.h6">@(_editId is null ? "Add" : "Edit") liability</MudText></TitleContent>
    <DialogContent>
        <MudTextField @bind-Value="_name" Label="Name" Class="mb-2" />
        <MudSelect T="int" @bind-Value="_type" Label="Type" Class="mb-2">
            <MudSelectItem T="int" Value="0">Mortgage</MudSelectItem>
            <MudSelectItem T="int" Value="1">Loan</MudSelectItem>
            <MudSelectItem T="int" Value="2">Credit card</MudSelectItem>
            <MudSelectItem T="int" Value="3">Other</MudSelectItem>
        </MudSelect>
        <MudNumericField @bind-Value="_balance" Label="Balance" Format="C" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _dialog = false)">Cancel</MudButton>
        <MudButton Color="MudBlazor.Color.Primary" Variant="Variant.Filled" OnClick="Save">Save</MudButton>
    </DialogActions>
</MudDialog>
