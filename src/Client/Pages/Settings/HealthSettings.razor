@page "/settings/health"

<PageTitle>Health Settings</PageTitle>
<MudText Typo="Typo.h5" Class="mb-3">Health Savings Account (HSA)</MudText>

<MudTable Items="_rows" Hover="true" Striped="true" Dense="true" Loading="_loading">
    <HeaderContent>
        <MudTh>Member</MudTh>
        <MudTh>Has HSA</MudTh>
        <MudTh>Annual contribution</MudTh>
        <MudTh>HSA catch-up (55+)</MudTh>
        <MudTh></MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd>@Name(context.FamilyMemberId)</MudTd>
        <MudTd>@(context.HasHsa ? "Yes" : "No")</MudTd>
        <MudTd>@context.AnnualHsaContribution.ToString("C")</MudTd>
        <MudTd>@(context.HasHsaCatchup ? "Yes" : "No")</MudTd>
        <MudTd>
            <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="MudBlazor.Color.Warning" OnClick="@(() => Edit(context))" />
        </MudTd>
    </RowTemplate>
</MudTable>

<MudDialog @bind-Visible="_dialogOpen">
    <TitleContent><MudText Typo="Typo.h6">Edit HSA profile</MudText></TitleContent>
    <DialogContent>
        <MudSwitch @bind-Value="_hasHsa" Label="Has HSA" Color="MudBlazor.Color.Primary" Class="mb-2" />
        <MudNumericField @bind-Value="_annual" Label="Annual HSA contribution (employee + employer)" Class="mb-2" />
        <MudSwitch @bind-Value="_hsaCatchup" Label="HSA catch-up (55+)" Color="MudBlazor.Color.Primary" Class="mb-2" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _dialogOpen = false)">Cancel</MudButton>
        <MudButton Color="MudBlazor.Color.Primary" Variant="Variant.Filled" OnClick="Save">Save</MudButton>
    </DialogActions>
</MudDialog>
