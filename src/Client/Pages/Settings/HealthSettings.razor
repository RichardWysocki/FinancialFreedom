@page "/settings/health"
@using System.Net.Http.Json
@using FinancialFreedom.Shared
@inject HttpClient Http
@inject ISnackbar Snackbar

<PageTitle>Health Settings</PageTitle>
<MudText Typo="Typo.h5" Class="mb-3">Health Savings Account (HSA)</MudText>

<MudTable Items="_rows" Hover="true" Striped="true" Dense="true" Loading="_loading">
    <HeaderContent>
        <MudTh>Member</MudTh>
        <MudTh>Has HSA</MudTh>
        <MudTh>Annual contribution</MudTh>
        <MudTh>HSA catch-up (55+)</MudTh>
        <MudTh></MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd>@Name(context.FamilyMemberId)</MudTd>
        <MudTd>@(context.HasHsa ? "Yes" : "No")</MudTd>
        <MudTd>@context.AnnualHsaContribution.ToString("C")</MudTd>
        <MudTd>@(context.HasHsaCatchup ? "Yes" : "No")</MudTd>
        <MudTd>
            <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="MudBlazor.Color.Warning" OnClick="@(() => Edit(context))" />
        </MudTd>
    </RowTemplate>
</MudTable>

<MudDialog @bind-Visible="_dialogOpen">
    <TitleContent><MudText Typo="Typo.h6">Edit HSA profile</MudText></TitleContent>
    <DialogContent>
        <MudSwitch @bind-Value="_hasHsa" Label="Has HSA" Color="MudBlazor.Color.Primary" Class="mb-2" />
        <MudNumericField @bind-Value="_annual" Label="Annual HSA contribution (employee + employer)" Class="mb-2" />
        <MudSwitch @bind-Value="_hsaCatchup" Label="HSA catch-up (55+)" Color="MudBlazor.Color.Primary" Class="mb-2" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _dialogOpen = false)">Cancel</MudButton>
        <MudButton Color="MudBlazor.Color.Primary" Variant="Variant.Filled" OnClick="Save">Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private List<HsaProfileDto> _rows = [];
    private List<FamilyMemberDto> _members = [];
    private bool _loading = true;
    private bool _dialogOpen;
    private Guid _memberId;
    private bool _hasHsa;
    private decimal _annual;
    private bool _hsaCatchup;

    protected override async Task OnInitializedAsync() => await Reload();

    private async Task Reload()
    {
        _loading = true;
        _members = await Http.GetFromJsonAsync<List<FamilyMemberDto>>("api/family-members") ?? [];
        _rows = await Http.GetFromJsonAsync<List<HsaProfileDto>>("api/hsa-profiles") ?? [];
        _loading = false;
    }

    private string Name(Guid id) => _members.FirstOrDefault(m => m.Id == id)?.Name ?? id.ToString()[..8];

    private void Edit(HsaProfileDto row)
    {
        _memberId = row.FamilyMemberId;
        _hasHsa = row.HasHsa;
        _annual = row.AnnualHsaContribution;
        _hsaCatchup = row.HasHsaCatchup;
        _dialogOpen = true;
    }

    private async Task Save()
    {
        try
        {
            var dto = new HsaProfileDto(_memberId, _hasHsa, _annual, _hsaCatchup);
            var res = await Http.PutAsJsonAsync($"api/hsa-profiles/{_memberId}", dto);
            res.EnsureSuccessStatusCode();
            _dialogOpen = false;
            await Reload();
            Snackbar.Add("Saved.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }
}
