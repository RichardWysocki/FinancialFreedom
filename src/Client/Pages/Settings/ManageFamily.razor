@page "/settings/family"
@using System.Net.Http.Json
@using FinancialFreedom.Shared
@inject HttpClient Http
@inject ISnackbar Snackbar

<PageTitle>Manage Family</PageTitle>

<MudText Typo="Typo.h5" Class="mb-2">Manage Family Members</MudText>
<MudText Typo="Typo.body2" Class="mb-4">
    Add adults (max 2) and kids. Adults drive retirement and What-If projections; kids appear in net-worth views.
</MudText>

<MudButton Variant="Variant.Filled" Color="MudBlazor.Color.Warning" StartIcon="@Icons.Material.Filled.Add" Class="mb-3"
           OnClick="@(() => OpenEdit(null))">Add</MudButton>

<MudTable Items="_members" Hover="true" Striped="true" Dense="true">
    <HeaderContent>
        <MudTh>Name</MudTh>
        <MudTh>Type</MudTh>
        <MudTh>Date of birth</MudTh>
        <MudTh></MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Name">@context.Name</MudTd>
        <MudTd DataLabel="Type">@MemberTypeName(context.Type)</MudTd>
        <MudTd DataLabel="DOB">@context.DateOfBirth.ToString("d")</MudTd>
        <MudTd>
            <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="MudBlazor.Color.Warning" OnClick="@(() => OpenEdit(context))" />
            <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="MudBlazor.Color.Error" OnClick="@(() => Delete(context))" />
        </MudTd>
    </RowTemplate>
</MudTable>

<MudDialog @bind-Visible="_dialogOpen" Options="new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true }">
    <TitleContent>
        <MudText Typo="Typo.h6">@(_editing is null ? "Add" : "Edit") family member</MudText>
    </TitleContent>
    <DialogContent>
        <MudTextField @bind-Value="_formName" Label="Name" Required="true" Class="mb-2" />
        <MudText Typo="Typo.body2" Class="mb-1">Type</MudText>
        <MudRadioGroup T="int" @bind-Value="_formType" Class="mb-3">
            <MudRadio T="int" Value="0" Color="Color.Primary">Adult</MudRadio>
            <MudRadio T="int" Value="1" Color="Color.Primary">Kid</MudRadio>
        </MudRadioGroup>
        <MudDatePicker @bind-Date="_formDob" Label="Date of birth" Class="mb-2" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _dialogOpen = false)">Cancel</MudButton>
        <MudButton Color="MudBlazor.Color.Primary" Variant="Variant.Filled" OnClick="SaveDialog">Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private List<FamilyMemberDto> _members = [];
    private bool _dialogOpen;
    private FamilyMemberDto? _editing;
    private string _formName = "";
    private int _formType;
    private DateTime? _formDob = DateTime.Today.AddYears(-30);

    protected override async Task OnInitializedAsync() => await Reload();

    private async Task Reload()
    {
        _members = await Http.GetFromJsonAsync<List<FamilyMemberDto>>("api/family-members") ?? [];
    }

    private static string MemberTypeName(int t) => t == 0 ? "Adult" : "Kid";

    private void OpenEdit(FamilyMemberDto? m)
    {
        _editing = m;
        if (m is null)
        {
            _formName = "";
            _formType = 0;
            _formDob = DateTime.Today.AddYears(-35);
        }
        else
        {
            _formName = m.Name;
            _formType = m.Type;
            _formDob = m.DateOfBirth.ToDateTime(TimeOnly.MinValue);
        }

        _dialogOpen = true;
    }

    private async Task SaveDialog()
    {
        if (string.IsNullOrWhiteSpace(_formName) || _formDob is null)
        {
            Snackbar.Add("Name and date of birth are required.", Severity.Warning);
            return;
        }

        var dob = DateOnly.FromDateTime(_formDob.Value);
        var body = new FamilyMemberUpsertDto(_formName.Trim(), _formType, dob, _editing?.DisplayOrder ?? _members.Count);

        try
        {
            if (_editing is null)
            {
                var res = await Http.PostAsJsonAsync("api/family-members", body);
                res.EnsureSuccessStatusCode();
            }
            else
            {
                var res = await Http.PutAsJsonAsync($"api/family-members/{_editing.Id}", body);
                res.EnsureSuccessStatusCode();
            }

            _dialogOpen = false;
            await Reload();
            Snackbar.Add("Saved.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task Delete(FamilyMemberDto m)
    {
        try
        {
            var res = await Http.DeleteAsync($"api/family-members/{m.Id}");
            res.EnsureSuccessStatusCode();
            await Reload();
            Snackbar.Add("Deleted.", Severity.Info);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }
}
