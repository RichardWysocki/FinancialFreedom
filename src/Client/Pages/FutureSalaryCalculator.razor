@page "/future-salary"
@using System.Globalization
@using System.Net.Http.Json
@using System.Text
@using FinancialFreedom.Shared
@inject HttpClient Http
@inject IJSRuntime JS

<PageTitle>Future salary calculator</PageTitle>

<MudText Typo="Typo.h5" Class="mb-2">Future salary calculator</MudText>
<MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
    Enter your current age and the age you plan to retire. The table runs from your current age through retirement age, with one row per year.
    Calendar year is shown for reference (assuming this calendar year matches your current age row).
</MudText>

<MudGrid Class="mb-2">
    <MudItem xs="12" sm="6" md="3" lg="2">
        <MudNumericField T="int" @bind-Value="_model.CurrentAge" Label="Current age" Min="0" Max="120" />
    </MudItem>
    <MudItem xs="12" sm="6" md="3" lg="2">
        <MudNumericField T="int" @bind-Value="_model.RetirementAge" Label="Retirement age" Min="0" Max="120" />
    </MudItem>
    <MudItem xs="12" sm="6" md="4">
        <MudNumericField T="decimal" @bind-Value="_model.CurrentSalary" Label="Current annual salary" Format="C" />
    </MudItem>
    <MudItem xs="12" sm="6" md="4">
        <MudNumericField T="decimal" @bind-Value="_model.AnnualIncreasePercent" Label="Salary increase per year (%)" Step="0.1m" />
    </MudItem>
</MudGrid>

@if (_model.RetirementAge > _model.CurrentAge)
{
    <MudText Typo="Typo.body2" Class="mb-3">
        Estimated calendar year at retirement:
        <strong>@(DateTime.Today.Year + (_model.RetirementAge - _model.CurrentAge))</strong>
        <span class="mud-secondary-text"> (this year + years until you reach retirement age).</span>
    </MudText>
}

<MudStack Row="true" Spacing="2" Class="mb-2" Wrap="Wrap.Wrap">
    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="BuildTable" Disabled="_loading" StartIcon="@Icons.Material.Filled.TableChart">
        @if (_loading)
        {
            <text>Building…</text>
        }
        else
        {
            <text>Build table</text>
        }
    </MudButton>
    <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="ExportCsv" Disabled="@(_rows.Count == 0)" StartIcon="@Icons.Material.Filled.Download">
        Export CSV
    </MudButton>
</MudStack>

@if (!string.IsNullOrEmpty(_formError))
{
    <MudAlert Severity="Severity.Warning" Class="mt-3" Dense="true">@_formError</MudAlert>
}

@if (_rows.Count > 0)
{
    <MudText Typo="Typo.subtitle2" Class="mt-4 mb-2">
        Salary projection by age (@_rows.Count rows, ages @_model.CurrentAge–@_model.RetirementAge;
        calendar years @_startYear–@_endYear for reference)
    </MudText>
    <MudTable Items="_rows" Dense="true" Hover="true" Striped="true" Bordered="true" Breakpoint="Breakpoint.Sm">
        <HeaderContent>
            <MudTh>Age</MudTh>
            <MudTh>
                Calendar year <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-inline">(estimated)</MudText>
            </MudTh>
            <MudTh style="text-align:right">Projected salary</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Age">@context.Age</MudTd>
            <MudTd DataLabel="Year">@context.CalendarYear</MudTd>
            <MudTd DataLabel="Salary" style="text-align:right">@FormatMoney(context.Salary)</MudTd>
        </RowTemplate>
    </MudTable>
}

@code {
    private readonly FutureSalaryProjectionRequest _model = new()
    {
        CurrentAge = 35,
        RetirementAge = 65,
        CurrentSalary = 100_000m,
        AnnualIncreasePercent = 3m,
    };

    private readonly List<FutureSalaryProjectionRow> _rows = [];
    private string? _formError;
    private int _startYear;
    private int _endYear;
    private bool _loading;

    private async Task BuildTable()
    {
        _formError = null;
        _rows.Clear();
        _loading = true;
        try
        {
            var body = new FutureSalaryProjectionRequest
            {
                CurrentAge = _model.CurrentAge,
                RetirementAge = _model.RetirementAge,
                CurrentSalary = _model.CurrentSalary,
                AnnualIncreasePercent = _model.AnnualIncreasePercent,
                CalendarStartYear = DateTime.Today.Year,
            };

            var response = await Http.PostAsJsonAsync("api/FutureSalary/project", body);
            if (response.IsSuccessStatusCode)
            {
                var payload = await response.Content.ReadFromJsonAsync<FutureSalaryProjectionResponse>();
                if (payload?.Rows is { Count: > 0 })
                {
                    _startYear = payload.CalendarStartYear;
                    _endYear = payload.CalendarEndYear;
                    _rows.AddRange(payload.Rows);
                }
                else
                {
                    _formError = "Unexpected empty response from the server.";
                }
            }
            else
            {
                var err = await response.Content.ReadFromJsonAsync<ApiErrorResponse>();
                _formError = err?.Message ?? $"Request failed ({(int)response.StatusCode}).";
            }
        }
        catch (HttpRequestException ex)
        {
            _formError = $"Could not reach the server: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task ExportCsv()
    {
        var sb = new StringBuilder();
        sb.AppendLine("Age,Calendar year,Projected salary");
        foreach (var row in _rows)
        {
            sb.Append(row.Age.ToString(CultureInfo.InvariantCulture)).Append(',');
            sb.Append(row.CalendarYear.ToString(CultureInfo.InvariantCulture)).Append(',');
            sb.AppendLine(row.Salary.ToString("0.##", CultureInfo.InvariantCulture));
        }

        var bytes = Encoding.UTF8.GetBytes(sb.ToString());
        var b64 = Convert.ToBase64String(bytes);
        await JS.InvokeVoidAsync("ff.download", "future-salary-projection.csv", b64);
    }

    private static string FormatMoney(decimal value) =>
        value.ToString("C0", CultureInfo.CurrentCulture);
}
