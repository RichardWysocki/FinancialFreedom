@page "/financial-health/emergency"

<PageTitle>Emergency Fund</PageTitle>

<MudText Typo="Typo.h5" Class="mb-3">Emergency fund</MudText>

@if (_dashboard is not null)
{
    var emergency = _dashboard.ByCategory.FirstOrDefault(c => c.CategoryName.Contains("Emergency", StringComparison.OrdinalIgnoreCase));
    <MudPaper Class="pa-4" Elevation="1">
        <MudText Typo="Typo.body1">
            Total balances in categories tagged as emergency:
            <strong>@UiMoney.Format(emergency?.Amount ?? 0m)</strong>
        </MudText>
        <MudText Typo="Typo.body2" Class="mt-2" Color="MudBlazor.Color.Secondary">
            Tag accounts under Settings → Family Assets with your Emergency category (created automatically for new households).
        </MudText>
    </MudPaper>
}
