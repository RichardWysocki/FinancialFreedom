@page "/financial-health/wealth-withdrawal"

<PageTitle>Wealth Withdrawal</PageTitle>

<MudPaper Class="pa-4" Elevation="1">
    <MudText Typo="Typo.h5" Class="mb-2">Wealth withdrawal calculator</MudText>
    <MudText Typo="Typo.body1" Class="mb-2">
        Retirement withdrawals in this app use your <strong>Generic Settings → Retirement withdrawal rate</strong>
        applied to projected retirement balances at retirement.
    </MudText>
    <MudText Typo="Typo.body2" Color="MudBlazor.Color.Secondary">
        Adjust withdrawal rate and return assumptions under Settings → Generic Settings. Income Replacement shows the combined result including Social Security and HSA.
    </MudText>
</MudPaper>
