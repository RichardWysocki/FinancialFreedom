@page "/setup"

<PageTitle>Setup</PageTitle>

<MudText Typo="Typo.h5" Class="mb-3">Welcome — quick setup</MudText>

<MudStepper @bind-ActiveIndex="_step">
    <MudStep Title="Family">
        <MudText Class="mb-2">Add adults (max 2) and kids on <MudLink Href="settings/family">Manage Family</MudLink>.</MudText>
        <MudButton Variant="Variant.Filled" Color="MudBlazor.Color.Primary" OnClick="@(() => Nav.NavigateTo("settings/family"))">Open Manage Family</MudButton>
    </MudStep>
    <MudStep Title="Retirement &amp; HSA">
        <MudText Class="mb-2">Enter salaries and contributions under Retirement and Health settings.</MudText>
        <MudStack Row="true" Spacing="2">
            <MudButton Variant="Variant.Outlined" OnClick="@(() => Nav.NavigateTo("settings/retirement"))">Retirement</MudButton>
            <MudButton Variant="Variant.Outlined" OnClick="@(() => Nav.NavigateTo("settings/health"))">Health</MudButton>
        </MudStack>
    </MudStep>
    <MudStep Title="Accounts">
        <MudText Class="mb-2">Add accounts and owners under Family Assets.</MudText>
        <MudButton Variant="Variant.Filled" Color="MudBlazor.Color.Warning" OnClick="@(() => Nav.NavigateTo("settings/assets"))">Family Assets</MudButton>
    </MudStep>
    <MudStep Title="Done">
        <MudText>Visit <MudLink Href="/">Home</MudLink> for your dashboard.</MudText>
    </MudStep>
</MudStepper>
